# Tests for various temperature sensors
DICTIONARY atmega2560.dict
CONFIG temperature.cfg

# Set various temperatures
M104 S100
M105

M140 S60
M105

M140 S0

# Test multi-source Z thermal adjustment commands
SET_Z_THERMAL_ADJUST
SET_Z_THERMAL_ADJUST SOURCE=bed TEMP_COEFF=-0.004 REF_TEMP=15
SET_Z_THERMAL_ADJUST SOURCE=chamber TEMP_COEFF=-0.001 REF_TEMP=25
SET_Z_THERMAL_ADJUST ENABLE=0
SET_Z_THERMAL_ADJUST ENABLE=1

# Test "wait for temp" g-code
M109 S100
M109 S60
M105
